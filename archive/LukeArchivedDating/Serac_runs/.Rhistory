scale <- 1e6
## ribbon in millions
ribbon <- function(df, col, yr = 1850, scale = 1e6) {
i0 <- which(df$year != yr)[1]
x  <- df$year[i0:nrow(df)]
yL <- df$`0.025`[i0:nrow(df)] / scale
yU <- df$`0.975`[i0:nrow(df)] / scale
polygon(c(x, rev(x)), c(yL, rev(yU)),
border = NA, col = adjustcolor(col, alpha.f = 0.18))
}
## plotting in millions
yl <- c(
0,
max(blue$`0.975`, orca$`0.975`, hump$`0.975`,
fin$`0.975`, mink$`0.975`, na.rm = TRUE)
) / scale
plot(blue$year, blue$`0.5` / scale, type = "n",
ylim = yl, xlab = "Year", ylab = "Biomass (×10^6)")
## ribbons
ribbon(blue, "dodgerblue", scale = scale)
ribbon(orca, "red",        scale = scale)
ribbon(hump, "grey",       scale = scale)
ribbon(fin,  "purple",     scale = scale)
ribbon(mink, "darkgreen",  scale = scale)
## lines (in millions)
lines(blue$year, blue$`0.5`   / scale, lwd = 2, col = "dodgerblue")
lines(blue$year, blue$`0.975` / scale, lty = 2, col = "dodgerblue")
lines(blue$year, blue$`0.025` / scale, lty = 2, col = "dodgerblue")
lines(orca$year, orca$`0.5`   / scale, lwd = 2, col = "red")
lines(orca$year, orca$`0.975` / scale, lty = 2, col = "red")
lines(orca$year, orca$`0.025` / scale, lty = 2, col = "red")
lines(hump$year, hump$`0.5`   / scale, lwd = 2, col = "grey")
lines(hump$year, hump$`0.975` / scale, lty = 2, col = "grey")
lines(hump$year, hump$`0.025` / scale, lty = 2, col = "grey")
lines(fin$year, fin$`0.5`     / scale, lwd = 2, col = "purple")
lines(fin$year, fin$`0.975`   / scale, lty = 2, col = "purple")
lines(fin$year, fin$`0.025`   / scale, lty = 2, col = "purple")
lines(mink$year, mink$`0.5`   / scale, lwd = 2, col = "darkgreen")
lines(mink$year, mink$`0.975` / scale, lty = 2, col = "darkgreen")
lines(mink$year, mink$`0.025` / scale, lty = 2, col = "darkgreen")
legend("topright",
legend = c("Blue", "Orca", "Humpback", "Fin", "Minke"),
lty = 1, col = c("dodgerblue","red","grey","purple","darkgreen"),
bty = "n")
