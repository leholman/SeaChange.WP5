annotation_north_arrow(location = "tr", which_north = "true",
height = unit(0.9, "cm"), width = unit(0.9, "cm")) +
theme(
legend.position        = "inside",
legend.position.inside = c(0.98, 0.02),   # panel coords: 0,0 = bottom-left
legend.justification   = c(1, 0),         # anchor the legend's bottom-right corner there
legend.background      = element_rect(fill = adjustcolor("white", alpha.f = 0.6), color = NA),
legend.key             = element_rect(fill = "transparent", color = NA),
legend.margin          = margin(3, 3, 3, 3),
legend.key.height      = unit(0.7, "cm"),
legend.key.width       = unit(0.3, "cm"),
legend.text.position  = "left",
legend.title           = element_text(hjust = 0.5, size = 8),
legend.text            = element_text(size = 7)
)
library(ggOceanMaps)
library(sf)
library(ggspatial)
pt <- read.csv("metadata/sitemetadata.csv")
basemap(limits = c(-70, -56, -70, -60), bathy.style = "rcb",rotate = TRUE,glaciers = TRUE)+
#basemap(limits = c(-25, -12, 63, 67),rotate = TRUE)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color ="black",cex=3.5,crs = 4326)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color = c("#D55E00","#cc79a7","#0072B2","#f0e442","#009e73"),cex=2.5,crs = 4326)+
#ggspatial::geom_spatial_text(aes(x = Lon, y = Lat+0.04,label=CoreID),data = metadata, color = "darkred",cex=2)+
xlab("")+
ylab("")+
annotation_scale(location = "bl")+
annotation_north_arrow(location = "tr", which_north = "true", height = unit(0.9, "cm"), width = unit(0.9, "cm"))+
theme(legend.position = "right",
legend.justification = "bottom",
legend.background = element_rect(fill = "transparent", color = NA),
legend.key = element_rect(fill = "transparent", color = NA))
options(timeout = 1000)
basemap(limits = c(-70, -56, -70, -60), bathy.style = "rcb",rotate = TRUE,glaciers = TRUE)+
#basemap(limits = c(-25, -12, 63, 67),rotate = TRUE)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color ="black",cex=3.5,crs = 4326)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color = c("#D55E00","#cc79a7","#0072B2","#f0e442","#009e73"),cex=2.5,crs = 4326)+
#ggspatial::geom_spatial_text(aes(x = Lon, y = Lat+0.04,label=CoreID),data = metadata, color = "darkred",cex=2)+
xlab("")+
ylab("")+
annotation_scale(location = "bl")+
annotation_north_arrow(location = "tr", which_north = "true", height = unit(0.9, "cm"), width = unit(0.9, "cm"))+
theme(legend.position = "right",
legend.justification = "bottom",
legend.background = element_rect(fill = "transparent", color = NA),
legend.key = element_rect(fill = "transparent", color = NA))
