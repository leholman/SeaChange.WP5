library(tidyverse)
library(RColorBrewer)
library(iNEXT)
library(vegan)
library(pbmcapply)
library(rioja)
library(mgcv)
#read in metadata
metadat <- read.csv("metadata/RepMetaData.csv")
dates <- read.csv("metadata/dates.csv")
coredata <- read.csv("metadata/sitemetadata.csv")
## read in data
mam <- read.csv("cleandata/MAM.WP5.main.clean.csv",row.names = 1)
mam.tax <- read.csv("cleandata/MAM.WP5.main.clean.tax.csv",row.names = 1)
riz <- read.csv("cleandata/RIZ.WP5.main.clean.csv",row.names = 1)
riz.tax <- read.csv("cleandata/RIZ.WP5.main.clean.tax.csv",row.names = 1)
euk <- read.csv("cleandata/EUK.WP5.main.clean.csv",row.names = 1)
sp_list <- unique(euk.salkril.nReps.long$spp)
sp_list <- unique(euk.salkril.nReps.long$spp)
markers <- list(
"18S" = c("NS1.negatives.csv",     "NS2.negatives.csv"),
"16S" = c("NS1.MAM.negatives.csv", "NS2.MAM.negatives.csv"),
"12S" = c("NS1.RIZ.negatives.csv", "NS2.RIZ.negatives.csv")
)
summarise_marker <- function(files) {
reps <- c(); taxa <- c(); ext <- c()
for (f in files) {
x <- read.csv(c("cleandata/negatives/",f), check.names = FALSE)
cols <- grep("^(EUK|MAM|RIZ)[._]", names(x), value = TRUE)
m <- as.matrix(x[, cols])
reps <- c(reps, colSums(m))
ext  <- c(ext, grepl("extraction|ExBlank", cols, ignore.case = TRUE))
lab <- x$genus
lab[is.na(lab) | lab %in% c("", "Can't find taxa in database")] <- "Unassigned"
taxa <- c(taxa, tapply(rowSums(m), lab, sum))
}
taxa  <- tapply(taxa, names(taxa), sum)
other <- sort(taxa[!names(taxa) %in% c("Homo", "Unassigned")], decreasing = TRUE)[1:3]
data.frame(
extraction_reps = sum(ext),
pcr_reps        = sum(!ext),
median_reads    = median(reps),
max_reads       = max(reps),
total_reads     = sum(reps),
human_pct       = round(100 * taxa["Homo"] / sum(taxa), 1),
top_non_human   = paste0(names(other), " (", other, ")", collapse = "; ")
)
}
out <- do.call(rbind, lapply(markers, summarise_marker))
summarise_marker <- function(files) {
reps <- c(); taxa <- c(); ext <- c()
for (f in files) {
x <- read.csv(paste0("cleandata/negatives/",f), check.names = FALSE)
cols <- grep("^(EUK|MAM|RIZ)[._]", names(x), value = TRUE)
m <- as.matrix(x[, cols])
reps <- c(reps, colSums(m))
ext  <- c(ext, grepl("extraction|ExBlank", cols, ignore.case = TRUE))
lab <- x$genus
lab[is.na(lab) | lab %in% c("", "Can't find taxa in database")] <- "Unassigned"
taxa <- c(taxa, tapply(rowSums(m), lab, sum))
}
taxa  <- tapply(taxa, names(taxa), sum)
other <- sort(taxa[!names(taxa) %in% c("Homo", "Unassigned")], decreasing = TRUE)[1:3]
data.frame(
extraction_reps = sum(ext),
pcr_reps        = sum(!ext),
median_reads    = median(reps),
max_reads       = max(reps),
total_reads     = sum(reps),
human_pct       = round(100 * taxa["Homo"] / sum(taxa), 1),
top_non_human   = paste0(names(other), " (", other, ")", collapse = "; ")
)
}
out <- do.call(rbind, lapply(markers, summarise_marker))
out <- cbind(marker = names(markers), out)
View(out)
summarise_marker <- function(files) {
reps <- c(); taxa <- c(); ext <- c()
for (f in files) {
x <- read.csv(paste0("cleandata/negatives/",f), check.names = FALSE)
cols <- grep("^(EUK|MAM|RIZ)[._]", names(x), value = TRUE)
m <- as.matrix(x[, cols])
reps <- c(reps, colSums(m))
ext  <- c(ext, grepl("extraction|ExBlank", cols, ignore.case = TRUE))
lab <- x$genus
lab[is.na(lab) | lab %in% c("", "Can't find taxa in database")] <- "Unassigned"
taxa <- c(taxa, tapply(rowSums(m), lab, sum))
}
taxa  <- tapply(taxa, names(taxa), sum)
other <- sort(taxa[!names(taxa) %in% c("Homo", "Unassigned")], decreasing = TRUE)[1:3]
data.frame(
extraction_reps = sum(ext),
pcr_reps        = sum(!ext),
median_reads    = median(reps),
max_reads       = max(reps),
total_reads     = sum(reps),
under_100_reads = sum(reps > 0 & reps < 100),
over_1000_reads = sum(reps > 1000),
human_pct       = round(100 * taxa["Homo"] / sum(taxa), 1),
top_non_human   = paste0(names(other), " (", other, ")", collapse = "; ")
)
}
out <- do.call(rbind, lapply(markers, summarise_marker))
out <- cbind(marker = names(markers), out)
print(out)
write.csv(out, "summaryfiles/Supplementary_Table_negatives.csv", row.names = FALSE)
summarise_marker <- function(files) {
reps <- c(); taxa <- c(); ext <- c()
for (f in files) {
x <- read.csv(paste0("cleandata/negatives/",f), check.names = FALSE)
cols <- grep("^(EUK|MAM|RIZ)[._]", names(x), value = TRUE)
m <- as.matrix(x[, cols])
reps <- c(reps, colSums(m))
ext  <- c(ext, grepl("extraction|ExBlank", cols, ignore.case = TRUE))
lab <- x$genus
lab[is.na(lab) | lab %in% c("", "Can't find taxa in database")] <- "Unassigned"
taxa <- c(taxa, tapply(rowSums(m), lab, sum))
}
taxa  <- tapply(taxa, names(taxa), sum)
other <- sort(taxa[!names(taxa) %in% c("Homo", "Unassigned")], decreasing = TRUE)[1:5]
data.frame(
extraction_reps = sum(ext),
pcr_reps        = sum(!ext),
median_reads    = median(reps),
max_reads       = max(reps),
total_reads     = sum(reps),
under_100_reads = sum(reps > 0 & reps < 100),
over_1000_reads = sum(reps > 1000),
human_pct       = round(100 * taxa["Homo"] / sum(taxa), 1),
top_non_human   = paste0(names(other), " (", other, ")", collapse = "; ")
)
}
out <- do.call(rbind, lapply(markers, summarise_marker))
out <- cbind(marker = names(markers), out)
print(out)
write.csv(out, "summaryfiles/Supplementary_Table_negatives.csv", row.names = FALSE)
