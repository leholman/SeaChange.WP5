cat("=== Distance-based RDA and PERMANOVA results by taxonomic group ===\n\n")
library(vegan)
# define groups (must exist in workspace)
asv_groups <- list(
Metazoa  = ASVs.met,
Protists = ASVs.pro,
Bacteria = ASVs.bac
)
for (group_name in names(asv_groups)) {
cat("############################################################\n")
cat("Group:", group_name, "\n")
cat("############################################################\n\n")
# subset ASVs
group_asvs <- asv_groups[[group_name]]
mat <- euk.reps[rownames(euk.reps) %in% group_asvs, , drop = FALSE]
# relative abundance + match ordering
comm.raw <- prop.table(as.matrix(mat), 2)
comm <- t(comm.raw[, match(clim$longname, colnames(comm.raw))])
## dbRDA
cat("---- dbRDA: Bray ----\n")
mod_bray <- dbrda(
comm ~ whale_s + PC1_s + PC2_s + Condition(site),
data = beta,
distance = "bray"
)
perm <- how(blocks = alpha$site, nperm = 1000)
print(anova(mod_bray, permutations = perm))
print(anova(mod_bray, by = "terms", permutations = perm))
cat("\n---- dbRDA: Jaccard ----\n")
mod_jacc <- dbrda(
comm ~ whale_s + PC1_s + PC2_s + Condition(site),
data = beta,
distance = "jacc"
)
print(anova(mod_jacc, permutations = perm))
print(anova(mod_jacc, by = "terms", permutations = perm))
## variance partitioning
cat("\n---- Variance partitioning: Bray ----\n")
var_bray <- varpart(
vegdist(comm, "bray"),
~ PC1_s + PC2_s,
~ whale_s,
data = beta
)
print(var_bray)
cat("\n---- Variance partitioning: Jaccard ----\n")
var_jacc <- varpart(
vegdist(comm, "jacc", binary = TRUE),
~ PC1_s + PC2_s,
~ whale_s,
data = beta
)
print(var_jacc)
## PERMANOVA
cat("\n---- PERMANOVA: Bray ----\n")
perm_bray <- adonis2(
vegdist(comm, method = "bray") ~  PC1_s + PC2_s + whale_s,
data = beta,
permutations = how(blocks = beta$site, nperm = 10000),
by = "margin"
)
print(perm_bray)
cat("\n---- PERMANOVA: Jaccard ----\n")
perm_jacc <- adonis2(
vegdist(comm, method = "jacc", binary = TRUE) ~  PC1_s + PC2_s + whale_s,
data = beta,
permutations = how(blocks = beta$site, nperm = 10000),
by = "margin"
)
print(perm_jacc)
cat("\n\n")
}
sink()
?varpart
# Versions for methods reporting
cat("R:", as.character(getRversion()), "\n\n")
pkgs <- c("vegan", "lme4", "Hmsc", "dada2", "clam", "zCompositions")
for (p in pkgs) {
v <- tryCatch(
as.character(packageVersion(p)),
error = function(e) "NOT INSTALLED"
)
cat(sprintf("%-15s %s\n", p, v))
}
