## assume 'sam' exists with columns: Year, JAN...DEC
months <- colnames(sam)[-1]                      # month columns
## 1) flatten to a single vector in time order (row wise: Jan..Dec for each year)
y_all  <- c(t(as.matrix(sam[months])))           # numeric vector, length = nrow(sam)*12
## 2) build matching Year and Month vectors
yr_all <- rep(sam$Year, each = 12)               # repeat each year 12 times
mo_all <- rep(seq_along(months), times = nrow(sam))
## 3) drop missing values (e.g., incomplete last year)
ok <- !is.na(y_all)
y_all  <- y_all[ok]
yr_all <- yr_all[ok]
mo_all <- mo_all[ok]
## 4) make a long data frame and order by time
sam_long <- data.frame(Year = yr_all, Month = mo_all, Value = y_all)
sam_long <- sam_long[order(sam_long$Year, sam_long$Month), ]
## 5) optional date column for time plots
