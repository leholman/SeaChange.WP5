# Simulation: proportion of positive PCR replicates vs template concentration
# conc = expected molecules per reaction (λ); eff = per-molecule amplification prob
simulate_proportion <- function(conc_seq = seq(0, 6, by = 0.1),
n_reps = 10,        # replicates per condition
n_runs = 1000,      # repeated experiments to get variability
eff = 1) {          # amplification efficiency (0-1)
stopifnot(all(conc_seq >= 0), n_reps > 0, n_runs > 0, eff >= 0, eff <= 1)
# theoretical curve: P(positive) = 1 - exp(-eff * λ)
theo <- 1 - exp(-eff * conc_seq)
# empirical simulation
med <- lo <- hi <- numeric(length(conc_seq))
for (i in seq_along(conc_seq)) {
lam <- conc_seq[i]
# for each "run", do n_reps replicates and record fraction positive
frac_pos <- replicate(n_runs, {
# molecules per replicate ~ Poisson(lam)
n_mol <- rpois(n_reps, lam)
# successes per replicate ~ Binomial(n_mol, eff); positive if ≥1 success
pos <- rbinom(n_reps, size = n_mol, prob = eff) > 0
mean(pos)
})
med[i] <- median(frac_pos)
lo[i]  <- quantile(frac_pos, 0.025, names = FALSE)
hi[i]  <- quantile(frac_pos, 0.975, names = FALSE)
}
out <- data.frame(conc = conc_seq, theo = theo, median = med, lo = lo, hi = hi)
return(out)
}
# Example usage
set.seed(1)
res <- simulate_proportion(conc_seq = seq(0, 6, by = 0.1), n_reps = 10, n_runs = 2000, eff = 1)
# Plot (base R): empirical median and 95% band vs theoretical curve
plot(res$conc, res$median, type = "l", lwd = 2, ylim = c(0, 1),
xlab = "Expected molecules per reaction (λ, proportional to concentration)",
ylab = "Proportion positive among 10 PCR replicates")
lines(res$conc, res$lo, lty = 2)
lines(res$conc, res$hi, lty = 2)
lines(res$conc, res$theo, col = "gray40", lwd = 2)
legend("bottomright",
legend = c("Empirical median", "Empirical 95% band", "Theoretical 1 - exp(-λ*eff)"),
lty = c(1, 2, 1), lwd = c(2, 1, 2), col = c("black", "black", "gray40"), bty = "n")
# Plot (base R): empirical median and 95% band vs theoretical curve
plot(log10(res$conc), res$median, type = "l", lwd = 2, ylim = c(0, 1),
xlab = "Expected molecules per reaction (λ, proportional to concentration)",
ylab = "Proportion positive among 10 PCR replicates")
lines(res$conc, res$lo, lty = 2)
lines(res$conc, res$hi, lty = 2)
lines(res$conc, res$theo, col = "gray40", lwd = 2)
legend("bottomright",
legend = c("Empirical median", "Empirical 95% band", "Theoretical 1 - exp(-λ*eff)"),
lty = c(1, 2, 1), lwd = c(2, 1, 2), col = c("black", "black", "gray40"), bty = "n")
