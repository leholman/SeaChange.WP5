library(shape)
for (s in unique(nmds_sites)) {
idx <- which(nmds_sites == s)
ord <- idx[order(nmds_years[idx])]
# draw lines first
lines(EUK.nMDS.j$points[ord, 1],
EUK.nMDS.j$points[ord, 2],
col = nmds_cols[idx[1]], lwd = 1.2)
# then just one arrow on the last segment to show direction
n <- length(ord)
Arrows(EUK.nMDS.j$points[ord[n-1], 1], EUK.nMDS.j$points[ord[n-1], 2],
EUK.nMDS.j$points[ord[n], 1],   EUK.nMDS.j$points[ord[n], 2],
col = nmds_cols[idx[1]], arr.type = "triangle",
arr.length = 0.15, arr.width = 0.1, lwd = 1.2, arr.adj = 1)
}
