# Fit a GAMM with an AR(1) autocorrelation structure
# Assuming 'y' is the response, 'x' is a predictor, and 'time' is the ordering variable
model <- gamm(cbind(value, 8 - value) ~ PC1_s + PC2_s + whale_s + site,
data = d2,
correlation = corAR1(form = ~ dates),
method = "REML")
