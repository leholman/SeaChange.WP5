####====0.1 Functions====####
# Calculate the PZIPSO25 index from IPSO25 and HBI-III concentrations.
# ip25, hbi3: numeric vectors (ng/g dry sediment).
# c: optional balance factor; if NULL it is calculated as mean(ip25)/mean(hbi3).
# Returns a numeric vector of index values (0–1) with "c" stored as an attribute.
pzi_ipso25 <- function(ip25, hbi3, c = NULL, na.rm = TRUE) {
if (is.null(c)) {
c <- mean(ip25, na.rm = na.rm) / mean(hbi3, na.rm = na.rm)
}
out <- ip25 / (ip25 + c * hbi3)
attr(out, "c") <- c
out
}
pzi_ipso25(clim.MC$IPSO25..ng.g.,clim.MC$HBI_III..ng.g.)
plot(pzi_ipso25(clim.MC$IPSO25..ng.g.,clim.MC$HBI_III..ng.g.))
clim.MC$PZIPSO25index <-pzi_ipso25(clim.MC$IPSO25..ng.g.,clim.MC$HBI_III..ng.g.)
View(clim.MC)
plot(clim.p68$PZIPSO25..PIPSO25.calculated.after.Vorr....)
View(clim.MC)
####====0.1 Functions====####
# Calculate the PZIPSO25 index from IPSO25 and HBI-III concentrations.
# ip25, hbi3: numeric vectors (ng/g dry sediment).
# c: optional balance factor; if NULL it is calculated as mean(ip25)/mean(hbi3).
# Returns a numeric vector of index values (0–1) with "c" stored as an attribute.
pzi_ipso25 <- function(ip25, hbi3, c = NULL, na.rm = TRUE) {
if (is.null(c)) {
c <- mean(ip25, na.rm = na.rm) / mean(hbi3, na.rm = na.rm)
}
out <- ip25 / (ip25 +(c * hbi3))
attr(out, "c") <- c
out
}
clim.MC$PZIPSO25index <-pzi_ipso25(clim.MC$IPSO25..ng.g.,clim.MC$HBI_III..ng.g.)
View(clim.MC)
####====0.1 Functions====####
# Calculate the PZIPSO25 index from IPSO25 and HBI-III concentrations.
# ip25, hbi3: numeric vectors (ng/g dry sediment).
# c: optional balance factor; if NULL it is calculated as mean(ip25)/mean(hbi3).
# Returns a numeric vector of index values (0–1) with "c" stored as an attribute.
pzi_ipso25 <- function(ip25, hbi3, c = NULL, na.rm = TRUE) {
if (is.null(c)) {
c <- mean(ip25, na.rm = na.rm) / mean(hbi3, na.rm = na.rm)
}
out <- ip25 / (ip25 +(c * hbi3))
attr(out, "c") <- c
out
}
