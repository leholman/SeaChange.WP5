abline(lm(Y.fam[, "Euphausiidae"] ~ beta$PC1_s), lwd = 2, lty = 2)
plot(beta$whale_s, Y.fam[, "Euphausiidae"],
col = cols[beta$site], pch = pchs[beta$site],
