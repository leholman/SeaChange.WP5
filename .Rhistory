.rare_apply <- if (requireNamespace("pbmcapply", quietly = TRUE)) {
function(X, FUN) pbmcapply::pbmclapply(X, FUN, mc.cores = .cores, mc.preschedule = TRUE)
} else {
function(X, FUN) lapply(X, FUN)
}
.cores <- if (.Platform$OS.type == "windows") 1L else
max(1L, parallel::detectCores() - 1L)
########################################################################
## Section 1 — helper functions (self-contained)
########################################################################
add.alpha <- function(col, alpha = 1) {
apply(sapply(col, col2rgb) / 255, 2,
function(x) rgb(x[1], x[2], x[3], alpha = alpha))
}
## Hill numbers q0/q1/q2 for one count vector
hill_3 <- function(v) {
v <- v[v > 0]
if (length(v) == 0 || sum(v) == 0) return(c(q0 = NA, q1 = NA, q2 = NA))
p <- v / sum(v)
c(q0 = length(v),
q1 = exp(-sum(p * log(p))),
q2 = 1 / sum(p^2))
}
## one rarefaction draw of a feature-by-sample matrix -> per-sample Hill nums
## keep = optional vector of feature (row) names to retain AFTER rarefying
one_draw <- function(mat, depth, keep = NULL) {
rare <- t(vegan::rrarefy(t(mat), sample = depth))
if (!is.null(keep)) rare <- rare[rownames(rare) %in% keep, , drop = FALSE]
hills <- t(apply(rare, 2, hill_3))
data.frame(sample = rownames(hills), hills, row.names = NULL)
}
## N rarefaction replicates -> long data frame with a 'draw' id
rarefy_hills <- function(mat, depth, N = N_DRAWS, seed = SEED, keep = NULL) {
set.seed(seed)
out <- .rare_apply(seq_len(N), function(i) one_draw(mat, depth, keep = keep))
do.call(rbind, Map(function(d, i) { d$draw <- i; d }, out, seq_along(out)))
}
## per-sample mean & sd of q0/q1/q2 across draws (base R)
summarise_hill <- function(alpha_all) {
m <- aggregate(cbind(q0, q1, q2) ~ sample, data = alpha_all,
FUN = function(x) mean(x, na.rm = TRUE), na.action = na.pass)
s <- aggregate(cbind(q0, q1, q2) ~ sample, data = alpha_all,
FUN = function(x) sd(x, na.rm = TRUE), na.action = na.pass)
names(m)[-1] <- paste0(names(m)[-1], "_mean")
names(s)[-1] <- paste0(names(s)[-1], "_sd")
merge(m, s, by = "sample")
}
## collapse nPCR replicates (strip trailing .<digit>) -> per-replicate
## means of the _mean cols, root-mean-square of the _sd cols
collapse_reps <- function(avg) {
avg$replicate <- sub("(.*)\\.[0-9]+$", "\\1", avg$sample)
mean_cols <- grep("_mean$", names(avg), value = TRUE)
sd_cols   <- grep("_sd$",   names(avg), value = TRUE)
mm <- aggregate(avg[mean_cols], by = list(replicate = avg$replicate),
FUN = function(x) mean(x, na.rm = TRUE))
ss <- aggregate(avg[sd_cols], by = list(replicate = avg$replicate),
FUN = function(x) sqrt(mean(x^2, na.rm = TRUE)))
merge(mm, ss, by = "replicate")
}
