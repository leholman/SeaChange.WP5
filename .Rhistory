#### now lets run a HMSC model with all taxa
library(Hmsc)
# -- Data prep ----------------------------------------------------------------
comm.raw.t <- t(as.matrix(euk.reps))
comm.raw.t <- comm.raw.t[match(clim$longname, rownames(comm.raw.t)), ]
# Normalise on full community FIRST
comm.prop <- comm.raw.t / rowSums(comm.raw.t)
# High-confidence Subdivision assignments only (>=60%)
tax.filt <- euk.tax[euk.tax$Subdivision.1 >= 60 & !is.na(euk.tax$Subdivision), ]
# Intersect ASVs, subset, collapse to Subdivision
shared.asvs <- intersect(colnames(comm.prop), tax.filt$ASV)
comm.filt   <- comm.prop[, shared.asvs, drop = FALSE]
tax.filt    <- tax.filt[match(shared.asvs, tax.filt$ASV), ]
comm.sub    <- t(rowsum(t(comm.filt), group = tax.filt$Subdivision, na.rm = TRUE))
# Zero replacement and CLR transformation
zero_replace <- function(x, delta = NULL) {
if (is.null(delta)) delta <- min(x[x > 0]) * 0.65
x[x == 0] <- delta
x <- x / rowSums(x)
x
}
clr <- function(x) {
lx <- log(x)
lx - rowMeans(lx)
}
zero_pct <- colMeans(comm.sub == 0)
comm.sub <- comm.sub[, zero_pct < 0.70]
comm.sub <- zero_replace(comm.sub)
Y <- clr(comm.sub)
cat("Subdivisions retained:", ncol(Y), "\n")
comm.sub <- zero_replace(comm.sub)
Y <- clr(comm.sub)
cat("Samples:", nrow(Y), "| Subdivisions:", ncol(Y), "\n")
# Predictors
# whale = Southern Ocean whale biomass: high pre-whaling, crashes ~1900s
# residual correlation PC1 ~ whale after removing time trend = 0.11 (safe to model together)
X <- data.frame(
PC1   = as.numeric(scale(beta$PC1_s)),
PC2   = as.numeric(scale(beta$PC2_s)),
whale = as.numeric(scale(beta$whale_s))
)
# -- Model --------------------------------------------------------------------
studyDesign <- data.frame(site = factor(beta$site))
rL.site     <- HmscRandomLevel(units = levels(studyDesign$site))
m <- Hmsc(
Y           = Y,
XData       = X,
XFormula    = ~ PC1 + PC2 + whale,
distr       = "normal",
studyDesign = studyDesign,
ranLevels   = list(site = rL.site)
)
m <- sampleMcmc(m,
thin      = 10,
samples   = 1000,
transient = 5000,
nChains   = 4,
nParallel = 4,
verbose   = 500
)
if (!requireNamespace("EWSmethods", quietly = TRUE)) {
install.packages("EWSmethods")
}
library(EWSmethods)
if (!dir.exists("figures/EWS")) dir.create("figures/EWS", recursive = TRUE)
## --- helper: run multiEWS for one site, one CLR matrix ----------------------
## Y_mat: sample x taxon CLR matrix, rows aligned with `beta`
## site_id: which site to subset
## method: "rolling" or "expanding"
## winsize: % of series for rolling window (default 50)
run_multiEWS_site <- function(Y_mat, site_id, beta_df,
method = "rolling", winsize = 50,
threshold = 2,
tail.direction = "one.tailed",
burn_in = 5) {
idx <- which(beta_df$site == site_id)
if (length(idx) < 8) {
message("Site ", site_id, " has only ", length(idx),
" samples — skipping (too short for EWS).")
return(NULL)
}
yrs   <- beta_df$year[idx]
ord   <- order(yrs)
idx   <- idx[ord]
yrs   <- yrs[ord]
## EWSmethods wants a data.frame: first column = time, rest = variables
dat <- data.frame(time = yrs, Y_mat[idx, , drop = FALSE])
## drop any taxa that are constant within this site (zero variance breaks
## eigenvalue / AR(1) calculations)
v <- apply(dat[, -1, drop = FALSE], 2, var, na.rm = TRUE)
keep <- v > .Machine$double.eps
if (sum(keep) < 2) {
message("Site ", site_id,
" has <2 variable taxa after filtering — skipping.")
return(NULL)
}
dat <- dat[, c(TRUE, keep), drop = FALSE]
res <- tryCatch({
if (method == "rolling") {
multiEWS(data = dat, method = "rolling", winsize = winsize)
} else {
multiEWS(data = dat, method = "expanding",
threshold = threshold,
tail.direction = tail.direction,
burn_in = burn_in)
}
}, error = function(e) {
message("multiEWS failed for site ", site_id, ": ", conditionMessage(e))
NULL
})
res
}
## --- run for both datasets, both methods, all sites -------------------------
sites_ews <- levels(beta$site)
ews_all_roll <- setNames(
lapply(sites_ews, function(s) run_multiEWS_site(Y, s, beta, method = "rolling")),
sites_ews)
ews_all_exp <- setNames(
lapply(sites_ews, function(s) run_multiEWS_site(Y, s, beta, method = "expanding")),
sites_ews)
ews_met_roll <- setNames(
lapply(sites_ews, function(s) run_multiEWS_site(Y.fam, s, beta, method = "rolling")),
sites_ews)
ews_met_exp <- setNames(
lapply(sites_ews, function(s) run_multiEWS_site(Y.fam, s, beta, method = "expanding")),
sites_ews)
## --- save the default plots from EWSmethods --------------------------------
save_ews_plot <- function(res, file, w = 9, h = 7) {
if (is.null(res)) return(invisible(NULL))
pdf(file, width = w, height = h)
print(plot(res))
dev.off()
}
for (s in sites_ews) {
save_ews_plot(ews_all_roll[[s]],
paste0("figures/EWS/EWS_alltaxa_rolling_", s, ".pdf"))
save_ews_plot(ews_all_exp[[s]],
paste0("figures/EWS/EWS_alltaxa_expanding_", s, ".pdf"))
save_ews_plot(ews_met_roll[[s]],
paste0("figures/EWS/EWS_metazoa_rolling_", s, ".pdf"))
save_ews_plot(ews_met_exp[[s]],
paste0("figures/EWS/EWS_metazoa_expanding_", s, ".pdf"))
}
