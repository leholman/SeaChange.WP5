#Aggregate same species
euk.pha.sum<- colSums(euk.pha)
euk.pha.sum.avr <- average_by_reps(euk.pha.sum,gsub("(.*).[0-9]$","\\1",names(euk.pha.sum)))
euk.pha.sum
gsub("(.*).[0-9]$","\\1",names(euk.pha.sum))
## lets make a avr dataset
