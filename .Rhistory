points(combinedSAM.s$year,combinedSAM.s$SAM_Index_5yr,type="l",lwd=2,col=add.alpha("dodgerblue",0.6))
points(combinedSAM.s$year,combinedSAM.s$SAM_Index_7yr,type="l",lwd=2,col=add.alpha("dodgerblue",0.8))
