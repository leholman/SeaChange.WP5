#  final read imbalance in 150 metabarcoding
#  libraries, given noisy quantification
# -------------------------------------------
library(tidyverse)
## ---------------------------
## 1. Key parameters & helpers
## ---------------------------
n_samples      <- 150               # number of libraries
target_reads   <- 1e8               # desired reads per library (scales away)
pool_grid      <- c(1,2,3,5,10,15,
30,50,75)       # how many initial sub-pools to test
reps           <- 1000              # Monte-Carlo replicates
## Error model ― “sigmoidal” with heavy tails
pct_large      <- 0.15              # minority with big errors
sigma_small    <- 0.05              # SD for the bulk (±10 % typical)
sigma_large    <- 0.40              # SD for the tails (up to 200 %)
sigma_pool     <- 0.02              # 2 % SD when re-measuring a pooled tube
clip_eps       <- function(x) pmax(pmin(x,  2.0), -0.99)   # cap at ±200 %
draw_eps       <- function(n){
big   <- rbinom(n,1,pct_large)==1
eps   <- ifelse(big,
rnorm(n,0,sigma_large),
rnorm(n,0,sigma_small))
clip_eps(eps)
}
## ---------------------------
## 2. Single Monte-Carlo run
## ---------------------------
one_run <- function(k){
eps <- draw_eps(n_samples)          # sample-level errors
if(k == 1){
factors <- 1 + eps                # one-shot pool
}else{
# Randomly split into k sub-pools
groups   <- split(sample(n_samples), rep(1:k, length.out = n_samples))
factors  <- numeric(n_samples)
for(g in groups){
eps_g      <- eps[g]
avg_eps_g  <- mean(eps_g)       # averages cancel within pool
delta_g    <- clip_eps(rnorm(1,0,sigma_pool))  # 2nd measurement error
factors[g] <- ((1+eps_g)/(1+avg_eps_g))*(1+delta_g)
}
}
factors / mean(factors)             # re-scale so mean = 1 (100 M reads)
}
## ---------------------------
## 3. Replicate across grid
## ---------------------------
set.seed(123)                         # reproducible
res <- map_dfr(pool_grid, function(k){
sims <- replicate(reps, one_run(k), simplify = FALSE)
cvec <- sapply(sims, sd)
rvec <- sapply(sims, function(v)
quantile(v,0.95)/quantile(v,0.05))
tibble(initial_pools = k,
mean_CV       = mean(cvec),
sd_CV         = sd(cvec),
mean_95_5     = mean(rvec))
})
print(res, width = Inf)
## ---------------------------
## 4. Visualise
## ---------------------------
ggplot(res, aes(initial_pools, mean_CV)) +
geom_line() +
geom_point() +
scale_x_log10(breaks = pool_grid) +
labs(x = "Number of initial sub-pools (log scale)",
y = "Mean CV of final sample reads",
title = "Pooling granularity vs. read imbalance") +
theme_bw()
View(res)
draw_eps       <- function(n){
big   <- rbinom(n,1,pct_large)==1
eps   <- ifelse(big,
rnorm(n,0,sigma_large),
rnorm(n,0,sigma_small))
clip_eps(eps)
}
