## ---- validate before doing anything -----------------------------------
.need_cols <- function(obj, cols, name) {
if (!exists(name)) stop(sprintf("Object '%s' not loaded.", name), call. = FALSE)
miss <- setdiff(cols, names(obj))
if (length(miss))
stop(sprintf("'%s' missing column(s): %s", name, paste(miss, collapse = ", ")),
call. = FALSE)
}
.need_mat <- function(name) {
if (!exists(name)) stop(sprintf("Matrix '%s' not loaded.", name), call. = FALSE)
if (is.null(rownames(get(name))) || is.null(colnames(get(name))))
stop(sprintf("'%s' needs both row- and col-names.", name), call. = FALSE)
}
.need_cols(clim,          c("Site","SampleID","CalYear",
"SAM_Index_3yr","ENSO_3yr","SIC_mean"), "clim")
.need_cols(expandedDates, c("SampleName","Site","SampleID","CalYear"), "expandedDates")
.need_cols(whales,        c("year","biomass"), "whales")
.need_cols(coredata,      c("Site","col"), "coredata")
.need_mat("euk"); .need_mat("euk.reps")
.need_cols(euk.pr2.2,     c("X.1","Genus","Genus.1"), "euk.pr2.2")
if (RUN_HMSC)
.need_cols(euk.tax, c("ASV","Subdivision","Subdivision.1","family","Family.1"), "euk.tax")
message("Section 2 OK — all required objects present.")
## ---- build the replicate<->sample join key (this is the line that was
##      missing from the old run) ----------------------------------------
clim$longname <- expandedDates$SampleName[
match(paste(clim$Site, clim$SampleID, sep = "_"),
paste(expandedDates$Site, expandedDates$SampleID, sep = "_"))]
## >>> CHECK: most of the 'matched' should equal 'n'
print(c(n = nrow(clim), matched = sum(!is.na(clim$longname))))
## 3a. ASV-level rarefaction (all taxa) ---------------------------------
lib_sizes <- colSums(euk)
euk_filt  <- as.matrix(euk[, lib_sizes >= N_READS])
message(sprintf("ASV alpha: %d samples pass >= %d reads (of %d).",
ncol(euk_filt), N_READS, ncol(euk)))
asv_all              <- rarefy_hills(euk_filt, N_READS)
ASV.alpha_avg        <- summarise_hill(asv_all)
ASV.alpha_avg_reps   <- collapse_reps(ASV.alpha_avg)
## >>> CHECK: replicate-level ASV richness / Shannon / Simpson
print(head(ASV.alpha_avg_reps))
## 3b. Genus-level rarefaction ------------------------------------------
valid_genus_ASVs <- euk.pr2.2$X.1[euk.pr2.2$Genus.1 > 60 & !is.na(euk.pr2.2$Genus)]
genus_map        <- setNames(euk.pr2.2$Genus, euk.pr2.2$X.1)
euk_genus     <- euk[rownames(euk) %in% valid_genus_ASVs, ]
genus_names   <- genus_map[rownames(euk_genus)]
euk_genus_agg <- rowsum(euk_genus, group = genus_names)
lib_sizes_genus <- colSums(euk_genus_agg)
euk_genus_filt  <- as.matrix(euk_genus_agg[, lib_sizes_genus >= N_READS])
message(sprintf("Genus alpha: %d genera, %d samples pass filter.",
nrow(euk_genus_filt), ncol(euk_genus_filt)))
genus_all             <- rarefy_hills(euk_genus_filt, N_READS)
alpha_genus_avg       <- summarise_hill(genus_all)
alpha_genus_avg_reps  <- collapse_reps(alpha_genus_avg)
## >>> CHECK
print(head(alpha_genus_avg_reps))
## 3c. Build the modelling frame with RAW climate -----------------------
i_asv   <- match(clim$longname, ASV.alpha_avg_reps$replicate)
i_genus <- match(clim$longname, alpha_genus_avg_reps$replicate)
alpha <- data.frame(
sample   = paste(clim$Site, clim$SampleID),
site     = factor(clim$Site),
year     = clim$CalYear,
ASV_Q0   = ASV.alpha_avg_reps$q0_mean[i_asv],
ASV_Q1   = ASV.alpha_avg_reps$q1_mean[i_asv],
ASV_Q2   = ASV.alpha_avg_reps$q2_mean[i_asv],
genus_Q0 = alpha_genus_avg_reps$q0_mean[i_genus],
genus_Q1 = alpha_genus_avg_reps$q1_mean[i_genus],
genus_Q2 = alpha_genus_avg_reps$q2_mean[i_genus],
whale    = whales$biomass[match(round(clim$CalYear), whales$year)],
whale_s  = as.numeric(scale(whales$biomass[match(round(clim$CalYear), whales$year)])),
SAM_s    = as.numeric(scale(clim$SAM_Index_3yr)),
ENSO_s   = as.numeric(scale(clim$ENSO_3yr)),
SeaIce_s = as.numeric(scale(clim$SIC_mean)),
stringsAsFactors = FALSE
)
## >>> CHECK: NA counts. Diversity cols heavily NA while climate isn't
##            => the longname<->replicate join is off; stop and inspect.
print(nrow(alpha)); print(colSums(is.na(alpha)))
a_A0 <- lmer(ASV_Q0   ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
a_A1 <- lmer(ASV_Q1   ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
a_A2 <- lmer(ASV_Q2   ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
a_G0 <- lmer(genus_Q0 ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
a_G1 <- lmer(genus_Q1 ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
a_G2 <- lmer(genus_Q2 ~ SAM_s + ENSO_s + SeaIce_s + whale_s + (1|site), data = alpha, REML = TRUE)
mods <- list("ASV Q0" = a_A0, "ASV Q1" = a_A1, "ASV Q2" = a_A2,
"Genus Q0" = a_G0, "Genus Q1" = a_G1, "Genus Q2" = a_G2)
predictors <- c("SAM_s", "ENSO_s", "SeaIce_s", "whale_s")
## >>> CHECK: singular fits, then read summaries one at a time
print(sapply(mods, isSingular))
# summary(a_A0); summary(a_A1); summary(a_A2)
# summary(a_G0); summary(a_G1); summary(a_G2)
## 3e. Compact coefficient table + export ------------------------------
coef_df <- do.call(rbind, lapply(names(mods), function(m) {
mod <- mods[[m]]
sm  <- coef(summary(mod))
ci  <- confint(mod, method = "Wald")
do.call(rbind, lapply(predictors, function(p) {
if (!p %in% rownames(sm)) return(NULL)
data.frame(model = m, predictor = p,
estimate = sm[p, "Estimate"], SE = sm[p, "Std. Error"],
df = sm[p, "df"], t = sm[p, "t value"],
CI_lo = ci[p, 1], CI_hi = ci[p, 2],
p_value = sm[p, "Pr(>|t|)"],
stringsAsFactors = FALSE)
}))
}))
coef_df$sig <- cut(coef_df$p_value, c(-Inf, .001, .01, .05, .1, Inf),
labels = c("***","**","*",".",""))
num <- c("estimate","SE","df","t","CI_lo","CI_hi","p_value")
coef_df[num] <- round(coef_df[num], 4)
## >>> CHECK: your headline whale-vs-climate table
print(coef_df, row.names = FALSE)
write.csv(coef_df, "summaryfiles/LMM_alpha_results_compact_RAW.csv", row.names = FALSE)
if (requireNamespace("MuMIn", quietly = TRUE)) {
r2 <- t(sapply(mods, function(m) MuMIn::r.squaredGLMM(m)[1, c("R2m","R2c")]))
print(round(r2, 3))
}
beta <- data.frame(
sample   = paste(clim$Site, clim$SampleID),
site     = factor(clim$Site),
year     = clim$CalYear,
whale    = whales$biomass[match(round(clim$CalYear), whales$year)],
whale_s  = as.numeric(scale(whales$biomass[match(round(clim$CalYear), whales$year)])),
SAM_s    = as.numeric(scale(clim$SAM_Index_3yr)),
ENSO_s   = as.numeric(scale(clim$ENSO_3yr)),
SeaIce_s = as.numeric(scale(clim$SIC_mean)),
stringsAsFactors = FALSE
)
comm.raw <- prop.table(as.matrix(euk.reps), 2)
comm     <- t(comm.raw[, match(clim$longname, colnames(comm.raw))])
## >>> CHECK: rows of comm must equal nrow(beta); n_unmatched must be 0
print(c(comm_rows = nrow(comm), beta_rows = nrow(beta),
n_unmatched = sum(is.na(match(clim$longname, colnames(comm.raw))))))
## 4a. distance-based RDA -----------------------------------------------
mod_bray <- dbrda(comm ~ whale_s + SAM_s + ENSO_s + SeaIce_s + Condition(site),
data = beta, distance = "bray")
comm_rows
comm.raw
bad <- which(is.na(match(clim$longname, colnames(comm.raw))))
clim[bad, c("Site","SampleID","CalYear","longname")]
keep     <- !is.na(match(clim$longname, colnames(comm.raw)))
\
keep     <- !is.na(match(clim$longname, colnames(comm.raw)))
keep
clim_b   <- clim[keep, ]
beta     <- beta[keep, ]                       # keep beta in lock-step
comm     <- t(comm.raw[, match(clim_b$longname, colnames(comm.raw))])
stopifnot(nrow(comm) == nrow(beta), !anyNA(comm))   # must both pass now
## >>> CHECK: rows of comm must equal nrow(beta); n_unmatched must be 0
print(c(comm_rows = nrow(comm), beta_rows = nrow(beta),
n_unmatched = sum(is.na(match(clim$longname, colnames(comm.raw))))))
## 4a. distance-based RDA -----------------------------------------------
mod_bray <- dbrda(comm ~ whale_s + SAM_s + ENSO_s + SeaIce_s + Condition(site),
data = beta, distance = "bray")
mod_jacc <- dbrda(comm ~ whale_s + SAM_s + ENSO_s + SeaIce_s + Condition(site),
data = beta, distance = "jacc")
perm <- how(blocks = beta$site, nperm = 1000)
## >>> CHECK: overall then per-term (conditional) — Bray
print(anova(mod_bray, permutations = perm))
print(anova(mod_bray, by = "margin", permutations = perm))
## >>> CHECK: Jaccard
print(anova(mod_jacc, permutations = perm))
print(anova(mod_jacc, by = "margin", permutations = perm))
## 4b. variance partitioning (climate as ONE block vs whale) ------------
var_bray <- varpart(vegdist(comm, "bray"),
~ SAM_s + ENSO_s + SeaIce_s, ~ whale_s, data = beta)
var_jacc <- varpart(vegdist(comm, "jacc", binary = TRUE),
~ SAM_s + ENSO_s + SeaIce_s, ~ whale_s, data = beta)
## >>> CHECK: adjusted-R2 fractions; the SHARED fraction = whale/climate
##            temporal confounding readout
print(var_bray); print(var_jacc)
# plot(var_bray); plot(var_jacc)
## 4c. PERMANOVA --------------------------------------------------------
perm_bray <- adonis2(vegdist(comm, method = "bray") ~ SAM_s + ENSO_s + SeaIce_s + whale_s,
data = beta, permutations = how(blocks = beta$site, nperm = 10000),
by = "margin")
perm_jacc <- adonis2(vegdist(comm, method = "jacc", binary = TRUE) ~ SAM_s + ENSO_s + SeaIce_s + whale_s,
data = beta, permutations = how(blocks = beta$site, nperm = 10000),
by = "margin")
## >>> CHECK
print(perm_bray); print(perm_jacc)
## 4d. OPTIONAL: per-taxon-group beta -----------------------------------
## Needs ASV-id vectors per group. Derive from euk.tax if you have it,
## or supply your own ASVs.met / ASVs.pro / ASVs.bac. Off by default.
if (RUN_BYGROUP_BETA) {
if (!all(sapply(c("ASVs.met","ASVs.pro","ASVs.bac"), exists)))
stop("RUN_BYGROUP_BETA needs ASVs.met / ASVs.pro / ASVs.bac.", call. = FALSE)
asv_groups <- list(Metazoa = ASVs.met, Protists = ASVs.pro, Bacteria = ASVs.bac)
sink("summaryfiles/Betaresults_RAW.txt")
for (g in names(asv_groups)) {
cat("\n############ Group:", g, "############\n")
mat  <- euk.reps[rownames(euk.reps) %in% asv_groups[[g]], , drop = FALSE]
cr   <- prop.table(as.matrix(mat), 2)
cg   <- t(cr[, match(clim$longname, colnames(cr))])
mb <- dbrda(cg ~ whale_s + SAM_s + ENSO_s + SeaIce_s + Condition(site), data = beta, distance = "bray")
mj <- dbrda(cg ~ whale_s + SAM_s + ENSO_s + SeaIce_s + Condition(site), data = beta, distance = "jacc")
cat("\n-- dbRDA Bray (margin) --\n");  print(anova(mb, by = "margin", permutations = perm))
cat("\n-- dbRDA Jaccard (margin) --\n"); print(anova(mj, by = "margin", permutations = perm))
cat("\n-- varpart Bray --\n")
print(varpart(vegdist(cg, "bray"), ~ SAM_s + ENSO_s + SeaIce_s, ~ whale_s, data = beta))
cat("\n-- PERMANOVA Bray (margin) --\n")
print(adonis2(vegdist(cg, "bray") ~ SAM_s + ENSO_s + SeaIce_s + whale_s,
data = beta, permutations = how(blocks = beta$site, nperm = 10000), by = "margin"))
}
sink()
message("Wrote summaryfiles/Betaresults_RAW.txt")
}
RUN_HMSC         <- TRUE
########################################################################
## Section 5 — HMSC  (optional; slow)
########################################################################
## Two models: Subdivision-level CLR, and Metazoa family-level CLR.
## Key change vs PCA version:
##   XFormula = ~ SAM + ENSO + SeaIce + whale
##   VP grouping  group = c(1, 2, 2, 2, 3)   (was c(1,2,2,3))
##   fixed-effect rows 2:5  (was 2:4)
if (RUN_HMSC) {
library(Hmsc)
dir.create("figures/HMSC", showWarnings = FALSE, recursive = TRUE)
## shared prep
comm.raw.t <- t(as.matrix(euk.reps))
comm.raw.t <- comm.raw.t[match(clim$longname, rownames(comm.raw.t)), ]
comm.prop  <- comm.raw.t / rowSums(comm.raw.t)
zero_replace <- function(x, delta = NULL) {
if (is.null(delta)) delta <- min(x[x > 0]) * 0.65
x[x == 0] <- delta; x / rowSums(x)
}
clr <- function(x) { lx <- log(x); lx - rowMeans(lx) }
X <- data.frame(SAM    = beta$SAM_s,
ENSO   = beta$ENSO_s,
SeaIce = beta$SeaIce_s,
whale  = beta$whale_s)
studyDesign <- data.frame(site = factor(beta$site))
rL.site     <- HmscRandomLevel(units = levels(studyDesign$site))
fit_hmsc <- function(Y) {
m <- Hmsc(Y = Y, XData = X, XFormula = ~ SAM + ENSO + SeaIce + whale,
distr = "normal", studyDesign = studyDesign,
ranLevels = list(site = rL.site))
sampleMcmc(m, thin = 100, samples = 1000, transient = 10000,
nChains = 4, nParallel = 4, verbose = 500)
}
## VP + fixed-effect support with the corrected 4-predictor indexing
hmsc_out <- function(m, Y, label) {
VP <- computeVariancePartitioning(m, group = c(1, 2, 2, 2, 3),
groupnames = c("Intercept", "Climate", "Whaling"))
cat("\n==", label, "== mean VP:\n"); print(round(rowMeans(VP$vals), 3))
pB <- getPostEstimate(m, parName = "Beta")
sup <- data.frame(
response  = rep(colnames(Y), each = 4),
predictor = rep(c("SAM","ENSO","SeaIce","whale"), times = ncol(Y)),
mean_beta = as.vector(pB$mean[2:5, ]),
P_pos     = as.vector(pB$support[2:5, ]),
P_neg     = as.vector(pB$supportNeg[2:5, ]),
stringsAsFactors = FALSE)
sup$strong <- sup$P_pos > 0.95 | sup$P_neg > 0.95
list(VP = VP, support = sup)
}
## 5a. Subdivision-level
tax.filt    <- euk.tax[euk.tax$Subdivision.1 >= 60 & !is.na(euk.tax$Subdivision), ]
shared      <- intersect(colnames(comm.prop), tax.filt$ASV)
comm.sub    <- t(rowsum(t(comm.prop[, shared, drop = FALSE]),
group = tax.filt$Subdivision[match(shared, tax.filt$ASV)]))
Y.sub <- clr(zero_replace(comm.sub))
m.sub <- fit_hmsc(Y.sub)
res.sub <- hmsc_out(m.sub, Y.sub, "Subdivision CLR")
print(res.sub$support[res.sub$support$strong, ])
## 5b. Metazoa family-level
tax.meta <- euk.tax[euk.tax$Subdivision == "Metazoa" &
!is.na(euk.tax$family) & euk.tax$Family.1 == 100 &
euk.tax$family != "", ]
shared.m <- intersect(colnames(comm.prop), tax.meta$ASV)
comm.fam <- t(rowsum(t(comm.prop[, shared.m, drop = FALSE]),
group = tax.meta$family[match(shared.m, tax.meta$ASV)]))
comm.fam <- comm.fam[, colMeans(comm.fam > 0) > 0.10]
Y.fam <- clr(zero_replace(comm.fam))
m.fam <- fit_hmsc(Y.fam)
res.fam <- hmsc_out(m.fam, Y.fam, "Metazoa family CLR")
print(res.fam$support[res.fam$support$strong, ])
write.csv(rbind(cbind(model = "Subdivision_CLR",     res.sub$support),
cbind(model = "Metazoa_family_CLR",  res.fam$support)),
"summaryfiles/HMSC_fixedeffects_compact_RAW.csv", row.names = FALSE)
message("Wrote summaryfiles/HMSC_fixedeffects_compact_RAW.csv")
}
