n_reps = 10,        # replicates per condition
n_runs = 100000,      # repeated experiments to get variability
eff = 1) {          # amplification efficiency (0-1)
stopifnot(all(conc_seq >= 0), n_reps > 0, n_runs > 0, eff >= 0, eff <= 1)
# theoretical curve: P(positive) = 1 - exp(-eff * λ)
theo <- 1 - exp(-eff * conc_seq)
# empirical simulation
med <- lo <- hi <- numeric(length(conc_seq))
for (i in seq_along(conc_seq)) {
lam <- conc_seq[i]
# for each "run", do n_reps replicates and record fraction positive
frac_pos <- replicate(n_runs, {
# molecules per replicate ~ Poisson(lam)
n_mol <- rpois(n_reps, lam)
# successes per replicate ~ Binomial(n_mol, eff); positive if ≥1 success
pos <- rbinom(n_reps, size = n_mol, prob = eff) > 0
mean(pos)
})
med[i] <- median(frac_pos)
lo[i]  <- quantile(frac_pos, 0.025, names = FALSE)
hi[i]  <- quantile(frac_pos, 0.975, names = FALSE)
}
out <- data.frame(conc = conc_seq, theo = theo, median = med, lo = lo, hi = hi)
return(out)
}
