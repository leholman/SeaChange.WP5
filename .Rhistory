plot(EUK.nMDS.j$points[,1],
EUK.nMDS.j$points[,2],
col = nmds_cols, pch = 16, xlab = "", ylab = "")
# Add trajectory lines per site
for (s in unique(nmds_sites)) {
idx <- which(nmds_sites == s)
ord <- idx[order(nmds_years[idx])]
n <- length(ord)
for (i in 1:(n - 1)) {
alpha <- as.integer(50 + 200 * (i / (n - 1)))  # 50 -> 250
seg_col <- paste0(nmds_cols[idx[1]], sprintf("%02X", alpha))
lines(EUK.nMDS.j$points[ord[c(i, i+1)], 1],
EUK.nMDS.j$points[ord[c(i, i+1)], 2],
col = seg_col, lwd = 1.5)
}
}
