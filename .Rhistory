## --- pull out Kendall tau values into a tidy summary table -----------------
## (rolling-window output has $cor with one tau per indicator)
summarise_ews <- function(ews_list, dataset_label) {
out <- lapply(names(ews_list), function(s) {
r <- ews_list[[s]]
if (is.null(r) || is.null(r$EWS$cor)) return(NULL)
tau <- as.numeric(r$EWS$cor)
data.frame(dataset  = dataset_label,
site     = s,
metric   = colnames(r$EWS$cor),
tau      = tau,
stringsAsFactors = FALSE)
})
do.call(rbind, out)
}
ews_tau_alltaxa <- summarise_ews(ews_all_roll, "AllTaxa_Subdivision")
ews_tau_metazoa <- summarise_ews(ews_met_roll, "Metazoa_Family")
ews_tau_summary <- rbind(ews_tau_alltaxa, ews_tau_metazoa)
