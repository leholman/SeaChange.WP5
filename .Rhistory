library(mgcv)
Dia.smol.ratio <- colSums(EUK.dia.3)/colSums(EUK.smolphy.2)
par(xpd = NA, mar = margins)
dates <- expandedDates$CalYear[match(names(Dia.smol.ratio), expandedDates$SampleName)]
sites <- expandedDates$Site[match(names(Dia.smol.ratio), expandedDates$SampleName)]
vals  <- log10(Dia.smol.ratio)
# empty plot — derivatives are on a different y-scale than log10(ratio)
plot(NA, xlim = c(1750, 2026), ylim = c(-0.05, 0.05),
xlab = "Date", ylab = "d log10(ratio) / d year", bty = "n")
abline(h = 0, col = "grey70", lty = 2)
for (s in unique(sites)) {
keep <- sites == s & is.finite(vals) & !is.na(dates)
if (sum(keep) > 5) {
ord <- order(dates[keep])
d <- dates[keep][ord]
v <- vals[keep][ord]
fit <- gam(v ~ s(d), method = "REML")
newd <- data.frame(d = seq(min(d), max(d), length.out = 200))
eps <- diff(range(d)) / 1000
X0 <- predict(fit, newd, type = "lpmatrix")
X1 <- predict(fit, data.frame(d = newd$d + eps), type = "lpmatrix")
Xp <- (X1 - X0) / eps
deriv <- as.vector(Xp %*% coef(fit))
se    <- sqrt(rowSums((Xp %*% vcov(fit)) * Xp))
lwr   <- deriv - 1.96 * se
upr   <- deriv + 1.96 * se
col_s <- coredata$col[match(toupper(s), coredata$Site)]
# CI ribbon
polygon(c(newd$d, rev(newd$d)), c(lwr, rev(upr)),
col = add.alpha(col_s, 0.2), border = NA)
# derivative line
lines(newd$d, deriv, col = col_s, lwd = 2)
# thicker where CI excludes 0
sig <- lwr > 0 | upr < 0
if (any(sig)) lines(newd$d[sig], deriv[sig], col = col_s, lwd = 4)
}
}
