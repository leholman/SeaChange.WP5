# Add trajectory lines per site
for (s in unique(nmds_sites)) {
idx <- which(nmds_sites == s)
ord <- idx[order(nmds_years[idx])]
n <- length(ord)
# draw full trajectory as lines
lines(EUK.nMDS.j$points[ord, 1],
EUK.nMDS.j$points[ord, 2],
col = nmds_cols[idx[1]], lwd = 1.2)
# arrow at the midpoint segment
mid <- floor(n / 2)
arrows(EUK.nMDS.j$points[ord[mid], 1],   EUK.nMDS.j$points[ord[mid], 2],
EUK.nMDS.j$points[ord[mid+1], 1], EUK.nMDS.j$points[ord[mid+1], 2],
col = nmds_cols[idx[1]], length = 0.06, angle = 20, lwd = 1.5)
}
