# Observed Euphausiidae and Salpidae across sites over time
par(mfrow = c(1, 2))
sites  <- levels(factor(beta$site))
cols   <- setNames(c("steelblue","coral","forestgreen","purple","orange"), sites)
pchs   <- setNames(c(16, 17, 15, 18, 8), sites)
for (taxon in c("Euphausiidae", "Salpidae")) {
plot(beta$year, Y.fam[, taxon],
col  = cols[beta$site],
pch  = pchs[beta$site],
xlab = "Year",
ylab = "Hellinger abundance",
main = taxon,
type = "n")
# Add loess per site
for (s in sites) {
idx <- beta$site == s
lines(loess.smooth(beta$year[idx], Y.fam[idx, taxon], span = 0.5),
col = cols[s], lwd = 1.5, lty = 2)
points(beta$year[idx], Y.fam[idx, taxon],
col = cols[s], pch = pchs[s], cex = 0.9)
}
# Overall loess across all sites
lines(loess.smooth(beta$year, Y.fam[, taxon], span = 0.4),
col = "black", lwd = 2.5)
abline(v = 1900, lty = 3, col = "grey40")
text(1901, max(Y.fam[, taxon]) * 0.95, "whaling\nstart",
cex = 0.7, col = "grey40", adj = 0)
}
legend("topleft", legend = sites, col = cols, pch = pchs,
bty = "n", cex = 0.8)
par(mfrow = c(1, 1))
# What do the sites look like in terms of coastal character?
# First just look at the raw community composition per site
par(mfrow = c(1, 1))
# Mean Hellinger abundance of key taxa by site
taxa_interest <- c("Euphausiidae", "Salpidae", "Monhysteridae",
"Leptolaimidae", "Siphonolaimidae")
site_means <- aggregate(Y.fam[, taxa_interest],
by = list(site = beta$site),
FUN = mean)
print(round(site_means, 4))
bc   <- vegdist(Y.fam, method = "bray")
pcoa <- cmdscale(bc, k = 2, eig = TRUE)
plot(pcoa$points,
col = cols[beta$site],
pch = pchs[beta$site],
xlab = paste0("PCoA1 (", round(pcoa$eig[1]/sum(pcoa$eig)*100, 1), "%)"),
ylab = paste0("PCoA2 (", round(pcoa$eig[2]/sum(pcoa$eig)*100, 1), "%)"),
main = "Metazoan community — sites in ordination space")
legend("topleft", legend = sites, col = cols, pch = pchs, bty = "n", cex = 0.8)
beta$coastal <- beta$site %in% c("BB", "MC", "SC")
# Does the krill/salp signal come from offshore sites only?
par(mfrow = c(2, 2))
for (taxon in c("Euphausiidae", "Salpidae")) {
for (grp in c(TRUE, FALSE)) {
idx   <- beta$coastal == grp
label <- ifelse(grp, "Coastal (MC/BB/SC)", "Offshore (p56/p68)")
plot(beta$year[idx], Y.fam[idx, taxon],
col  = cols[beta$site[idx]],
pch  = pchs[beta$site[idx]],
xlab = "Year", ylab = "Hellinger abundance",
main = paste(taxon, "-", label))
lines(loess.smooth(beta$year[idx], Y.fam[idx, taxon], span = 0.5),
lwd = 2, col = "black")
abline(v = 1900, lty = 3, col = "grey40")
}
}
par(mfrow = c(1, 1))
# Worth visualising PC1 explicitly to make sure you can describe it clearly
par(mfrow = c(2, 2))
plot(beta$year, beta$PC1_s,
col = cols[beta$site], pch = pchs[beta$site],
xlab = "Year", ylab = "PC1 (scaled)",
main = "Climate PC1 through time")
abline(h = 0, lty = 2, col = "grey60")
lines(loess.smooth(beta$year, beta$PC1_s, span = 0.4), lwd = 2)
plot(beta$year, beta$whale_s,
col = cols[beta$site], pch = pchs[beta$site],
xlab = "Year", ylab = "Whale biomass (scaled)",
main = "Whale biomass through time")
abline(v = 1900, lty = 3, col = "grey40")
lines(loess.smooth(beta$year, beta$whale_s, span = 0.4), lwd = 2)
# The key scatter — do krill track PC1 within sites?
plot(beta$PC1_s, Y.fam[, "Euphausiidae"],
col = cols[beta$site], pch = pchs[beta$site],
xlab = "PC1 (+SAM, -sea ice)", ylab = "Hellinger abundance",
