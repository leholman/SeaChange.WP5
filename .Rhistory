whale_families <- c("Balaenopteridae", "Balaenidae", "Delphinidae")
# --- MAM marker ---
mam_otu <- read.csv("cleandata/MAM.WP5.main.clean.csv",     row.names = 1)
mam_tax <- read.csv("cleandata/MAM.WP5.main.clean.tax.csv", row.names = 1)
