cor(resid_PC1, resid_whale)
cat("Raw correlation PC1 vs log(whale):",
round(cor(beta$PC1_s, log(beta$whale)), 3), "\n")
cat("Correlation after removing time trend:",
round(cor(resid_PC1, resid_whale), 3), "\n")
# Whale biomass is so tied to time that it may just be
# a smoother version of a time trend in your community data
# Worth fitting a third model with year instead of whale to check
X.time <- data.frame(
PC1  = as.numeric(scale(beta$PC1_s)),
year = as.numeric(scale(beta$year))
)
m.time <- Hmsc(
Y           = Y,
XData       = X.time,
XFormula    = ~ PC1 + year,
distr       = "normal",
studyDesign = studyDesign,
ranLevels   = list(site = rL.site)
)
m.time <- sampleMcmc(m.time,
thin       = 10,
samples    = 1000,
transient  = 5000,
nChains    = 4,
nParallel  = 4,
verbose    = 500
)
# Compare WAIC: does whale biomass explain community better than raw time?
preds.sub  <- computePredictedValues(m.sub,  expected = FALSE)
preds.time <- computePredictedValues(m.time, expected = FALSE)
waic.sub  <- evaluateModelFit(hM = m.sub,  predY = preds.sub)$WAIC
waic.time <- evaluateModelFit(hM = m.time, predY = preds.time)$WAIC
cat("WAIC — whale biomass model:", round(waic.sub,  2), "\n")
waic.sub
#### now lets run a HMSC model
library(Hmsc)
comm.raw.t <- t(as.matrix(euk.reps))
comm.raw.t <- comm.raw.t[match(clim$longname, rownames(comm.raw.t)), ]
# High-confidence Subdivision assignments only (>=60%)
tax.filt <- euk.tax[euk.tax$Subdivision.1 >= 60 & !is.na(euk.tax$Subdivision), ]
# Intersect ASVs, collapse to Subdivision, Hellinger transform
shared.asvs <- intersect(colnames(comm.raw.t), tax.filt$ASV)
comm.filt   <- comm.raw.t[, shared.asvs, drop = FALSE]
tax.filt    <- tax.filt[match(shared.asvs, tax.filt$ASV), ]
comm.sub <- t(rowsum(t(comm.filt), group = tax.filt$Subdivision, na.rm = TRUE))
hell     <- function(x) sqrt(x / rowSums(x))
Y        <- hell(comm.sub)
cat("Samples:", nrow(Y), "| Subdivisions:", ncol(Y), "\n")
View(Y)
# Predictors
# whale = Southern Ocean whale biomass: high pre-whaling, crashes ~1900s
# residual correlation PC1 ~ whale after removing time trend = 0.11 (safe to model together)
X <- data.frame(
PC1   = as.numeric(scale(beta$PC1_s)),
whale = as.numeric(scale(beta$whale_s))
)
studyDesign <- data.frame(site = factor(beta$site))
rL.site     <- HmscRandomLevel(units = levels(studyDesign$site))
m <- Hmsc(
Y           = Y,
XData       = X,
XFormula    = ~ PC1 + whale,
distr       = "normal",
studyDesign = studyDesign,
ranLevels   = list(site = rL.site)
)
m <- sampleMcmc(m,
thin      = 10,
samples   = 1000,
transient = 5000,
nChains   = 4,
nParallel = 4,
verbose   = 500
)
mpost    <- convertToCodaObject(m)
beta_ess <- effectiveSize(mpost$Beta)
beta_gel <- gelman.diag(mpost$Beta, multivariate = FALSE)$psrf
cat("ESS — Min:", round(min(beta_ess)),
"| Median:", round(median(beta_ess)),
"| % > 200:", round(mean(beta_ess > 200) * 100, 1), "%\n")
cat("G-R — Max:", round(max(beta_gel[, 1]), 3),
"| % > 1.05:", round(mean(beta_gel[, 1] > 1.05) * 100, 1), "%\n")
# Variance partitioning — design matrix cols: 1=Intercept, 2=PC1, 3=whale
VP <- computeVariancePartitioning(m,
group = c(1, 2, 3), groupnames = c("Intercept", "Climate", "Whaling"))
print(round(rowMeans(VP$vals), 3))
plotVariancePartitioning(m, VP = VP)
# Posterior support for fixed effects
postBeta   <- getPostEstimate(m, parName = "Beta")
support_df <- data.frame(
Subdivision = rep(colnames(Y), each = 2),
predictor   = rep(c("Climate_PC1", "Whaling"), times = ncol(Y)),
mean_beta   = c(rbind(postBeta$mean[2, ],       postBeta$mean[3, ])),
P_pos       = c(rbind(postBeta$support[2, ],    postBeta$support[3, ])),
P_neg       = c(rbind(postBeta$supportNeg[2, ], postBeta$supportNeg[3, ]))
)
support_df$direction <- ifelse(support_df$mean_beta > 0, "positive", "negative")
support_df$strong    <- support_df$P_pos > 0.90 | support_df$P_neg > 0.90
print(support_df[support_df$strong, c("Subdivision", "predictor", "mean_beta",
"P_pos", "P_neg", "direction")])
plotBeta(m, post = postBeta, param = "Support", supportLevel = 0.90,
split = 0.4, spNamesNumbers = c(TRUE, FALSE))
n_pred       <- 100
dummy_design <- data.frame(site = factor(rep(levels(studyDesign$site)[1], n_pred),
levels = levels(studyDesign$site)))
plot_response <- function(taxon) {
x_seq   <- seq(min(X$PC1),   max(X$PC1),   length.out = n_pred)
w_seq   <- seq(min(X$whale), max(X$whale), length.out = n_pred)
n_samp  <- m$samples * m$nChains
pm.clim <- Reduce("+", predict(m, XData = data.frame(PC1 = x_seq, whale = 0),
studyDesign = dummy_design, expected = TRUE,
predictEtaMean = TRUE)) / n_samp
pm.whal <- Reduce("+", predict(m, XData = data.frame(PC1 = 0, whale = w_seq),
studyDesign = dummy_design, expected = TRUE,
predictEtaMean = TRUE)) / n_samp
par(mfrow = c(1, 2))
plot(x_seq, pm.clim[, taxon], type = "l", lwd = 2, col = "steelblue",
xlab = "Climate PC1 (scaled)", ylab = "Hellinger abundance",
main = paste(taxon, "~ Climate"))
abline(h = mean(Y[, taxon]), lty = 2, col = "grey60")
plot(w_seq, pm.whal[, taxon], type = "l", lwd = 2, col = "coral",
xlab = "Whale biomass (scaled)", ylab = "Hellinger abundance",
main = paste(taxon, "~ Whale biomass"))
abline(h = mean(Y[, taxon]), lty = 2, col = "grey60")
par(mfrow = c(1, 1))
}
# Call for any taxon with strong posterior support e.g.:
plot_response("Metazoa")
exit
