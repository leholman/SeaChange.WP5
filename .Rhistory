ylim = c(0, max(upper)),axes=FALSE)
polygon(c(year, rev(year)),
c(upper, rev(lower)),
col = "darkgoldenrod1",
border = NA)
lines(year, mid, col = "darkgoldenrod4",lwd=3)
axis(2)
abline(v=1986,lty=2,lwd=2,col="darkred")
axis(1,lwd=1,lwd.ticks = 1,at = seq(2025,1775,-25),labels = seq(2025,1775,-25) )
dev.off()
