### attempt of a shared x axis
# Common, ordered time axis across all sites
all_years <- min(unique(na.omit(expandedDates$CalYear))):max(unique(na.omit(expandedDates$CalYear)))
sites     <- unique(expandedDates$Site)
# Helper: make a site x year matrix of *proportions* (averaging if multiple samples per year)
# rename the matrix arg so it won't collide with lapply's X
make_site_year <- function(site, M, map, years){
out <- sapply(years, function(y){
smps <- map$SampleName[map$Site == site & map$CalYear == y]
if (length(smps) == 0) {
rep(0, nrow(M))
} else if (length(smps) == 1) {
M[, smps, drop = FALSE][,1]
} else {
rowMeans(M[, smps, drop = FALSE], na.rm = TRUE)
}
})
rownames(out) <- rownames(M)
colnames(out) <- years
out
}
# now this works (no name collision)
site_mats <- setNames(
lapply(sites, make_site_year, M = EUK.tax.a.2, map = expandedDates, years = all_years),
sites
)
# Consistent spacing and limits
sp <- 0.2
ylim <- c(0, 1)
pal <- rev(getPalette(nrow(EUK.tax.a.2)))  # you already defined getPalette
par(mfrow = c(length(sites), 1),
mar = c(0.5, 4.1, 1.1, 1.1),  # small bottom margins for all but last
oma = c(6, 0, 0, 0),          # outer bottom margin for axis labels room
xpd = NA)
for (i in c(2,4,3,1,5)) {
site <- sites[i]
mat  <- site_mats[[site]]
# Draw the stacked barplot without x-axis ticks
bp <- barplot(mat,
col    = pal,
space  = 0,
width = 30,
ylim   = ylim,
border = NA,
xaxt   = "n",
yaxt   = "t")
# Add a site label on the left
mtext(site, side = 2, line = 3, las = 0, cex = 0.9)
## 2) Compute bar edges from bar midpoints (bp)
# Internal boundaries halfway between midpoints
mid_between <- (bp[-1] + bp[-length(bp)]) / 2
left_edge   <- c(bp[1] - (bp[2] - bp[1]) / 2, mid_between)
right_edge  <- c(mid_between, bp[length(bp)] + (bp[length(bp)] - bp[length(bp)-1]) / 2)
## 3) Cumulative bottoms/tops for each taxon across years (columns)
bot <- apply(mat, 2, function(x) c(0, cumsum(x)[-length(x)]))  # rows = taxa, cols = years
top <- apply(mat, 2, cumsum)
## 4) Semi-transparent ribbons connecting every adjacent pair (close ALL gaps)
pal_a <- add.alpha(pal, 0.35)  # tune alpha as you like
# Draw ribbons BEFORE re-drawing crisp bars (so ribbons show in gaps)
for (k in seq_len(nrow(mat))) {
for (i in seq_len(ncol(mat) - 1)) {
# skip degenerate polygons when both sides are zero height
if ((top[k, i] - bot[k, i]) == 0 && (top[k, i + 1] - bot[k, i + 1]) == 0) next
xpoly <- c(right_edge[i], left_edge[i + 1], left_edge[i + 1], right_edge[i])
ypoly <- c(top[k,   i],   top[k,   i + 1], bot[k,   i + 1], bot[k,   i])
polygon(xpoly, ypoly, col = pal_a[k], border = NA)
}
}
## 5) Re-draw bars on top so columns stay crisp
barplot(mat,
col    = pal,
space  = 0.05,
width  = 1.3,
ylim   = c(0, 1),
border = NA,
xaxt   = "n",
add    = TRUE)
# Only the bottom panel gets the shared x-axis
if (i == length(sites)) {
axis(1, at = bp, labels = all_years, las = 2, cex.axis = 0.8)
mtext("Calibrated year", side = 1, line = 4)
}
}
