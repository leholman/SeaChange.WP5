site_samples <- expandedDates$SampleName[expandedDates$Site == site]
# Match to calendar years and sort descending
cal_years <- expandedDates$CalYear[match(site_samples, expandedDates$SampleName)]
names(cal_years) <- site_samples
sorted_samples <- names(sort(cal_years, decreasing = TRUE))
# Subset and reorder columns in loopdat
loopdat <- EUK.met.2[, colnames(EUK.met.2) %in% sorted_samples, drop = FALSE]
loopdat <- loopdat[, sorted_samples, drop = FALSE]
# Barplot
pdf(paste0("figures/EUK.metazoa.", site, ".fam.pdf"), width = 7.5, height = 5)
par(mfrow = c(1,1), mar = c(3.1, 3.1, 1.1, 1.1), xpd = TRUE)
barplot(loopdat,
col = rev(getPalette(nrow(EUK.met.2))),
las = 2,
names.arg = expandedDates$CalYear[match(colnames(loopdat), expandedDates$SampleName)])
dev.off()
}
## ---- Legend for Metazoa only
pdf("figures/EUK.metazoa.family.legend.pdf", width = 4.5, height = 9)
par(mar = c(0, 0, 0, 0))
plot.new()
legend("center",
legend = rev(rownames(EUK.met.2)),
fill = getPalette(nrow(EUK.met.2)),
bty = "n",
border = NA,
cex = 0.6,
y.intersp = 0.7)
dev.off()
library(ggOceanMaps)
library(ggOceanMaps)
library(ggOceanMaps)
library(ggOceanMaps)
library(sf)
library(ggspatial)
pt <- read.csv("metadata/sitemetadata.csv")
pdf("mapping/OverviewV3smol.pdf",height = 5,width = 3.5)
basemap(limits = c(-70, -56, -70, -60), bathy.style = "rcb",rotate = TRUE,glaciers = TRUE)+
#basemap(limits = c(-25, -12, 63, 67),rotate = TRUE)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color ="black",cex=7.5,crs = 4326)+
ggspatial::geom_spatial_point(aes(x = Lon, y = Lat),data = pt, color = c("#D55E00","#cc79a7","#0072B2","#f0e442","#009e73"),cex=6,crs = 4326)+
#ggspatial::geom_spatial_text(aes(x = Lon, y = Lat+0.04,label=CoreID),data = metadata, color = "darkred",cex=2)+
xlab("Longitude")+
ylab("Latitude")+
annotation_scale(location = "bl")+
annotation_north_arrow(location = "tr", which_north = "true", height = unit(0.9, "cm"), width = unit(0.9, "cm"))
