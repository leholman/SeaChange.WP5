substr(names(euk.polarella.clean),9,10)
names(euk.polarella.clean
)
names(euk.polarella.clean)
sapply(strsplit(names(euk.polarella.clean), "\\."), function(x) x[3])
sapply(strsplit(names(euk.polarella.clean), "\\."), function(x) x[4])
euk.polarella.dat <- data.frame("raw.reads"=euk.polarella.clean,
"prop.reads"=euk.polarella.clean.p,
"site"=toupper(substr(names(euk.polarella.clean),8,9)),
"depth"=sapply(strsplit(names(euk.polarella.clean), "\\."), function(x) x[4]))
euk.polarella.dat$depth[euk.polarella.dat$depth=="0"]
euk.polarella.dat$depth[euk.polarella.dat$depth=="0"] <- 0.5
paste(euk.polarella.dat$site,euk.polarella.dat$depth)
paste(dates$Site,dates$Depth)
euk.polarella.dat$dates <- dates$CalYear[match(paste(euk.polarella.dat$site,euk.polarella.dat$depth),
paste(dates$Site,dates$Depth))]
View(euk.polarella.dat)
euk.polarella.dat <- data.frame("raw.reads"=euk.polarella.clean,
"prop.reads"=euk.polarella.clean.p,
"site"=toupper(substr(names(euk.polarella.clean),8,9)),
