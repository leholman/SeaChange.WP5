## Dummy dataset matching your design
set.seed(1)
site   <- factor(paste0("S", 1:3))
core   <- factor(paste0("C", 1:3))
depth  <- factor(c("shallow", "deep"))
marker <- factor(c("18S", "COI"))
tech   <- factor(paste0("T", 1:8))
dat <- expand.grid(
site   = site,
core   = core,
depth  = depth,
marker = marker,
tech   = tech
)
View(dat)
## enforce core nested in site (3 cores per site, reused labels)
dat$site_core <- interaction(dat$site, dat$core, drop = TRUE)
## sample-level ID (shared by 8 tech reps)
dat$sample_id <- interaction(dat$marker, dat$site, dat$core, dat$depth, drop = TRUE)
## simulate true effects
site_eff   <- rnorm(nlevels(site), 0, 0.4)
core_eff   <- rnorm(nlevels(dat$site_core), 0, 0.6)
depth_eff  <- c(shallow = 0, deep = -0.5)
marker_eff <- c(`18S` = 0, COI = -0.3)
## linear predictor
eta <- 2 +
site_eff[dat$site] +
core_eff[dat$site_core] +
depth_eff[dat$depth] +
marker_eff[dat$marker]
## add sample-level noise (technical reps share this)
sample_noise <- rnorm(nlevels(dat$sample_id), 0, 0.3)
eta <- eta + sample_noise[dat$sample_id]
View(dat)
View(data)
## negative binomial response
dat$richness <- rnbinom(
nrow(dat),
mu = exp(eta),
size = 1.2
)
View(dat)
library(lme4)
m_core <- glmer.nb(
richness ~ marker * site * depth +
site:core +            # cores differ within sites (what you care about)
site:core:depth +      # paired depth effect differs by core
(1 | marker:site:core:depth),  # sample-level effect for 8 tech reps
data = dat
)
summary(m_core)
anova(m_core)
eta
exp(eta)
rnbinom(
nrow(dat),
mu = exp(eta),
size = 80
)
rnbinom(
nrow(dat),
mu = exp(eta),
size = 8000
)
rnbinom(
nrow(dat),
mu = exp(eta)*100,
size = 1.2
)
## negative binomial response
dat$richness <- rnbinom(
nrow(dat),
mu = exp(eta)*100,
size = 1.2
)
str(dat)
head(dat)
