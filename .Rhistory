library(mgcv)
# helper: returns dates where the derivative CI excludes 0
sig_regions <- function(d, v, span_k = NULL) {
# k = NULL lets mgcv pick; set e.g. k = 5 if you have few points
fit <- gam(v ~ s(d, k = ifelse(is.null(span_k), -1, span_k)),
method = "REML")
# fine grid for derivative
newd <- data.frame(d = seq(min(d), max(d), length.out = 200))
eps <- diff(range(d)) / 1000
X0 <- predict(fit, newd, type = "lpmatrix")
X1 <- predict(fit, data.frame(d = newd$d + eps), type = "lpmatrix")
Xp <- (X1 - X0) / eps
deriv <- Xp %*% coef(fit)
se    <- sqrt(rowSums((Xp %*% vcov(fit)) * Xp))
lwr   <- deriv - 1.96 * se
upr   <- deriv + 1.96 * se
list(d = newd$d, deriv = deriv, lwr = lwr, upr = upr,
sig = (lwr > 0 | upr < 0))
}
# in your loop:
for (s in unique(sites)) {
keep <- sites == s & is.finite(vals) & !is.na(dates)
if (sum(keep) > 5) {
ord <- order(dates[keep])
d <- dates[keep][ord]
v <- vals[keep][ord]
fit <- gam(v ~ s(d), method = "REML")
pred <- predict(fit, se.fit = TRUE)
col_s <- coredata$col[match(toupper(s), coredata$Site)]
lines(d, pred$fit, col = col_s, lwd = 2)
# optional: thicken or recolor where slope is significantly non-zero
sr <- sig_regions(d, v)
if (any(sr$sig)) {
# interpolate fitted values onto the derivative grid
pred_grid <- predict(fit, data.frame(d = sr$d))
lines(sr$d[sr$sig], pred_grid[sr$sig], col = col_s, lwd = 4)
}
}
}
